{
  "_comment": "Per-bot agent-journal config. Edit ALL @@TOKEN@@ placeholders before install.",

  "bot_name": "@@BOT_NAME@@",
  "bot_email": "@@BOT_NAME@@@@@DOMAIN@@",
  "site_url": "https://@@BOT_NAME@@.@@DOMAIN@@",
  "site_title": "@@SITE_TITLE@@",
  "site_tagline": "@@SITE_TAGLINE@@",

  "journal_dir": "/home/@@BOT_NAME@@/journal",
  "web_dir": "/home/@@BOT_NAME@@/@@BOT_NAME@@.@@DOMAIN@@",

  "_autonomy_comment": "Two autonomy modes. Default (journal-only) leaves agent_dir UNSET so writes: can only reach the journal_dir + web_dir. Set agent_dir to give the bot write access to her broader account (matches maxine's setup). restrict_shell=true disables the shell: sidecar entirely — useful when running this on a production bot where you want full control over what executes.",
  "restrict_shell": false,

  "_backend_comment": "Pick one: kimi / minimax / claude. Each has built-in defaults; override fields as needed.",
  "backend": "kimi",
  "model": "kimi-k2.5",
  "api_key_secret": "MOONSHOT_API_KEY",
  "input_price_per_m": 0.60,
  "output_price_per_m": 2.50,

  "max_tokens_default": 12000,
  "max_tokens_ceiling": 24000,

  "_schedule_comment": "Hour of day (local, 0-23) the journal fires. If the cron polls hourly (0 * * * *), gating runs the writer at the first poll on/after this hour each day, once per day; a manual run on a prior day never suppresses today's scheduled run. With the default 6 AM cron (0 6 * * *) the gate simply confirms the daily slot. Set -1 to disable gating (run every tick). The bot can edit this value herself via writes:.",
  "journal_run_hour": 6,

  "_email_comment": "SMTP for outbound journal emails and email-action tasks. Optional; omit if the bot doesn't send.",
  "smtp_server": "@@SMTP_HOST@@",
  "smtp_port": 465,
  "email_password_secret": "@@EMAIL_PASSWORD_SECRET@@",
  "matt_bcc": "@@REVIEWER_EMAIL@@",

  "_research_comment": "Optional Brave Search secret. Without it, RESEARCH blocks return a 'disabled' placeholder.",
  "brave_search_secret": "BRAVE_SEARCH_API_KEY",

  "_site_comment": "Comment-form CGI integration. Disable if not running a CGI receiver.",
  "enable_comment_form": true,
  "comment_cgi_path": "/cgi-bin/comment.cgi",

  "reviewer_email": "<peer-reviewer-email>"
}
